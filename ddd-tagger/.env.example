# Copy to .env and fill in. Never commit or share .env.

# Jellyfin (Dashboard → API Keys → +). Needs admin rights to edit tags.
# Local address on the Pi (not the public domain) — works with network_mode: host in docker-compose.yml.
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=

# DoesTheDogDie.com (your profile page → API key).
# Free tier: non-commercial use only, 5,000 requests/month, attribution required.
DDD_API_KEY=

# ---- Optional tuning ----
# A topic needs at least this many "yes" votes...
MIN_YES_VOTES=3
# ...and at least this share of all votes.
MIN_YES_RATIO=0.75
# Max topics per title (photosensitivity topics are always kept on top of this).
MAX_TOPICS_PER_TITLE=8
# Re-query a title after this many days.
RECHECK_DAYS=30
RUN_EVERY_HOURS=24
# Stop before hitting the monthly cap.
DDD_MONTHLY_RESERVE=100
# true = single pass then exit (for testing).
RUN_ONCE=false
# true = log what would be tagged, write nothing.
DRY_RUN=false
